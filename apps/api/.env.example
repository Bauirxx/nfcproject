# Configuração do backend NFC Business. Copie para `.env` (fora do controlo de versões).
# Nenhum destes valores é um segredo real; preencha com os do seu ambiente. Descrição de cada um em src/config/env.ts.
# Uma variável presente mas vazia é recusada no arranque: descomente só as que preencher.

# development | test | production
NODE_ENV=development
PORT=3000

# Supabase (obrigatório em produção). Obtém-se no painel do projeto Supabase.
SUPABASE_URL=https://o-seu-projeto.supabase.co
# SUPABASE_ANON_KEY=
# Session pooler com o papel app_backend (ADR-0013). Segredo.
# DATABASE_URL=
# Só para convites, membros e Storage (ADR-0017). Segredo.
# SUPABASE_SERVICE_ROLE_KEY=

# Hash dos IPs nas estatísticas: 32 ou mais caracteres aleatórios (obrigatório em produção). Segredo.
# IP_HASH_SECRET=
# Origem pública do frontend (link do cartão no VCF e no email).
PUBLIC_APP_URL=http://localhost:5173
# Proxies à frente do backend: Vercel -> Render = 2.
TRUST_PROXY_HOPS=1

# Email pelo Resend (ADR-0019). Segredo.
# RESEND_API_KEY=
# EMAIL_FROM=NFC Business <onboarding@resend.dev>
# Destino dos alertas de operação (ADR-0021); sem ele, os alertas ficam só nos logs.
# ALERT_EMAIL_TO=
