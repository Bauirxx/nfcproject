# Configuração do backend NFC Business. Copie para `.env` (fora do controlo de versões).
# Nenhum destes valores é um segredo real; preencha com os do seu ambiente.

# development | test | production
NODE_ENV=development
PORT=3000

# Supabase (obrigatório em produção). Obtém-se no painel do projeto Supabase.
SUPABASE_URL=https://o-seu-projeto.supabase.co
SUPABASE_ANON_KEY=
