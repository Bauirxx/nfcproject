# Variáveis lidas só pelo vite.config.ts (Node). Nenhuma chega ao browser.
# Nunca criar variáveis VITE_ com tokens, chaves ou segredos (CLAUDE.md, regra 9).

# Em desenvolvimento a API é simulada com MSW. Para usar o backend real: API_MOCKING=false
API_MOCKING=true

# Destino do proxy /api em desenvolvimento, quando API_MOCKING=false
API_PROXY_TARGET=http://127.0.0.1:3000
