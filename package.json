{
  "name": "nfc-business",
  "version": "0.1.0",
  "private": true,
  "description": "NFC Business — cartões de visita digitais por NFC e QR Code",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nfc-business/web dev",
    "build": "pnpm --filter @nfc-business/web build",
    "preview": "pnpm --filter @nfc-business/web preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @nfc-business/web test:e2e",
    "check:bundle": "pnpm --filter @nfc-business/web check:bundle",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
